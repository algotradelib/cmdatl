// Channel breakout: buy when the close rises above the highest high of the last `entry` bars;
// sell when it falls below the lowest low of the last `exit` bars.
params {
  int<lower=1> entry = 20;
  int<lower=1> exit = 10;
  int<lower=0> quantity = 50;
}
series {
  real channel_high = ts_max(high, entry)[1];
  real channel_low = ts_min(low, exit)[1];
}
on_bar {
  if (close > channel_high) {
    target(quantity);
  } else if (close < channel_low) {
    target(0);
  }
}
